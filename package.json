{
  "name": "geo-quiz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter '!@geo/admin' -r --parallel run dev",
    "admin": "pnpm --filter @geo/admin dev",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "packs:validate": "tsx packages/server/src/validate-packs.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
