# Dependencies
node_modules/
package-lock.json
yarn.lock
# pnpm-lock.yaml is committed: Cloudflare Workers Builds detects the package
# manager from the lockfile. Without it, CI falls back to `bun install`, which
# can't resolve our pnpm `workspace:*` deps.

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock
*.sqlite
*.sqlite-journal

# Coverage
coverage/
.nyc_output/

# Misc
.cache/
.parcel-cache/
dist/

# Generated: flag SVGs copied from the flags pack into the web app's served
# public dir at build time (spec #180). Source of truth is packs/flags/assets/.
packages/web/public/flags/

# Claude Code local state (worktrees, job scratch)
.claude/*
!.claude/skills/
.agents/*
!.agents/skills/
