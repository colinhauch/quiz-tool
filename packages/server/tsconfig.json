{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"]
  },
  "include": ["src"],
  // The Node path (src/index.ts) still discovers packs at boot with no
  // compile-time edge (ADR-0001). But the Cloudflare Worker can't do runtime
  // discovery, so the build-time bundle (src/packs.generated.ts) imports every
  // pack's generators statically — a deliberate compile-time edge for that
  // target. This reference resolves those imports to the packs project's
  // declarations (not into this project's rootDir). See ADR-0001's amendment.
  "references": [{ "path": "../contract" }, { "path": "../engine" }, { "path": "../../packs" }]
}
