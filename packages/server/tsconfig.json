{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"]
  },
  "include": ["src"],
  // No reference to `packs`: the server discovers packs at boot and imports
  // their generator modules dynamically, so there is deliberately no
  // compile-time edge from application source to any pack (ADR-0001).
  "references": [{ "path": "../contract" }, { "path": "../engine" }]
}
