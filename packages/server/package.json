{
  "name": "@geo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "bundle-packs": "tsx scripts/bundle-packs.ts",
    "packs:import-coordinates": "tsx scripts/import-wikidata-coordinates.ts",
    "pretest": "tsx scripts/bundle-packs.ts",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "deploy:ci": "case \"$WORKERS_CI_BRANCH\" in dev) wrangler deploy --env dev ;; test) wrangler deploy --env test ;; *) echo \"No env deploy for branch '$WORKERS_CI_BRANCH'; uploading preview version\" && wrangler versions upload ;; esac"
  },
  "dependencies": {
    "@geo/contract": "workspace:*",
    "@geo/engine": "workspace:*",
    "@hono/node-server": "^1.13.8",
    "@supabase/supabase-js": "^2.112.2",
    "better-sqlite3": "^12.2.0",
    "hono": "^4.6.20",
    "jose": "^6.2.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "tsx": "^4.19.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.124.0"
  }
}
