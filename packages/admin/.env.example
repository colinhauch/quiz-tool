# @geo/admin — BFF environment template.
#
# Copy this file to `.env.local` (git-ignored) and fill in the values. The BFF
# (src/index.ts) reads it at startup; the SPA never does. None of these are
# VITE_-prefixed, so Vite cannot inline them into the client bundle — the
# service-role key stays server-side.
#
#   cp packages/admin/.env.example packages/admin/.env.local
#
# The Packs, Graph Health, and Generator Preview surfaces read the pack graph
# and need NOTHING here. Only the cross-user surfaces (Users, Results) need the
# service-role credentials below; without them those routes return a clear 500.

# The one Supabase project the admin reads — the same project the player app
# uses (packages/web/.env.production). It holds all three Environments as
# separate Postgres schemas (prod -> public, test -> test, dev -> dev); the
# BFF binds one service-role client per schema from these same two values, so
# nothing here is per-Environment (see CONTEXT.md's Environment/schema entries
# and spec #171/#172). The SPA's environment selector picks which one each
# request reads, no restart required.
SUPABASE_URL=https://your-project-ref.supabase.co

# The service_role secret. It bypasses RLS, which is how the admin reads across
# all users in every Environment's schema — so it is localhost-only and must
# never be committed or exposed to the browser. Get it from the Supabase
# dashboard:
#   Project Settings → API → Project API keys → `service_role` (Reveal).
SUPABASE_SERVICE_KEY=your-service-role-key

# Optional: override the BFF port (default 3101; the SPA proxy expects 3101).
# ADMIN_PORT=3101
