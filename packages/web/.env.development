# Supabase config for the browser client (packages/web/src/auth.ts).
# Publishable key is low-privilege by design (RLS keys on the forwarded user
# JWT, not this key) — same value already committed in packages/server/wrangler.toml.
VITE_SUPABASE_URL=https://fmxjevgxlnqujsqeqfwt.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_fAoIRUV4B8RRdytsQRPgjw_tGhmvYdo

# Local dev only: skip Supabase auth and run permanently signed-in, against the
# server's no-auth single-user sqlite mode (packages/server/src/index.ts). Never
# affects production (guarded by import.meta.env.DEV in auth.ts). To test the
# real sign-in flow locally instead, set VITE_DEV_NO_AUTH=false in a
# .env.development.local (gitignored).
VITE_DEV_NO_AUTH=true
